[global]
    font = JetBrainsMono Nerd Font 11
    markup = full
    format = "<b>%s</b>\n%b"
    sort = yes
    indicate_hidden = yes
    alignment = left
    bounce_freq = 0
    show_age_threshold = 60
    word_wrap = yes
    ignore_newline = no
    geometry = "300x5-10+40"
    transparency = 0
    idle_threshold = 120
    monitor = 0
    follow = mouse
    sticky_history = yes
    history_length = 20
    show_indicators = yes
    line_height = 0
    separator_height = 1
    padding = 8
    horizontal_padding = 8
    separator_color = frame
    startup_notification = false
    frame_width = 1
    frame_color = "#2a2a2a"

[urgency_low]
    background = "#0a0a0f"
    foreground = "#777777"
    timeout = 4

[urgency_normal]
    background = "#0a0a0f"
    foreground = "#aaaaaa"
    timeout = 6

[urgency_critical]
    background = "#0a0a0f"
    foreground = "#cccccc"
    timeout = 0
